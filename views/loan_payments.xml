<odoo>
    <data>
        <!-- Vista Árbol de Modelo loan application -->

        <record model="ir.ui.view" id="loan_payment_tree_id">
            <field name="name">loan.payment.tree</field>
            <field name="model">loan.payment</field>
            <field name="arch" type="xml">

                <tree editable="bottom" decoration-info="state in ('transfer', 'ministry_defense', 'ministry_defense_warrantor')">
                    <header>
                        <button name="create_report_excel" string="Reporte MINDEF" type="object"/>
                    </header>
                    <field name="loan_application_ids" optional="hide"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1" groups="base.group_multi_currency"/>
                    <field name="currency_id_dollar" invisible="1" groups="base.group_multi_currency"/>
                    <field name="special_case" invisible="1"/>
                    <field name="partner_id" optional="hide"/>
                    <field name="type_loan" optional="hide"/>
                    <field name="with_guarantor" optional="hide"/>
                    <field name="partner_status_especific" optional="hide"/>
                    <field name="name" optional="hide"/>

                    <field name="date"/>
                    <field name="date_payment"/>
                    <field name="period"/>
                    <field name="capital_initial" optional="show" widget="monetary"
                           options="{'currency_field': 'currency_id_dollar'}"/>
                    <field name="capital_index_initial" sum="Total" optional="show"/>
                    <field name="capital_index_initial_bolivianos" sum="Total" optional="hidden"/>
                    <field name="interest_base" optional="show" sum="Total"/>
                    <field name="interest_base_bolivianos" optional="hidden" sum="Total"/>
                    <field name="res_social" optional="show" sum="Total"/>
                    <field name="res_social_bolivianos" optional="hidden" sum="Total"/>
                    <field name="interest" sum="Total"/>
                    <field name="interest_base_mortgage" optional="show" sum="Total"/>
                    <field name="interest_mortgage" optional="show" sum="Total"/>
                    <field name="res_mortgage" optional="show" sum="Total"/>
                    <field name="mount" widget="monetary" options="{'currency_field': 'currency_id_dollar'}"
                           sum="Total"/>
                    <field name="interest_month_surpluy" sum="Total"/>
                    <field name="interest_month_surpluy_bolivianos" sum="Total"/>
                    <field name="balance_capital" widget="monetary" options="{'currency_field': 'currency_id_dollar'}"
                           sum="Total"/>
                    <field name="percentage_amount_min_def" optional="hidden" sum="Total"/>
                    <field name="percentage_amount_min_def_bolivianos" optional="hidden" sum="Total"/>
                    <field name="commission_min_def" optional="hidden" sum="Total"/>
                    <field name="coa_commission" optional="hidden" sum="Total"/>
                    <field name="coa_commission_bs" optional="hidden" sum="Total"/>
                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id_dollar'}"
                           sum="Total"/>
                    <field name="amount_total_bs" widget="monetary" sum="Total"/>
                    <field name="amount_total_bolivianos" sum="Total" optional="hidden"/>
                    <field name="amount_payment" widget="monetary" sum="Total"/>
                    <field name="amount_returned_coa" optional="hidden" sum="Total"/>

                    <field name="state" decoration-info="state == 'init' or state == 'in_queue'"
                           decoration-success="state == 'progress' or state == 'done'" widget="badge"/>
                    <field name="state_account" widget="badge"/>
                    <button name="open_loan_payment" type="object" class="oe_highlight"
                            icon="fa-eye"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="loan_payment_report_tree_id">
            <field name="name">loan.payment.tree</field>
            <field name="model">loan.payment</field>
            <field name="arch" type="xml">
                <tree editable="bottom" decoration-info="state in ('transfer', 'ministry_defense')"
                      decoration-danger="state == 'not_discounted'">
                    <field name="loan_application_ids" optional="hide"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1" groups="base.group_multi_currency"/>
                    <field name="currency_id_dollar" invisible="1" groups="base.group_multi_currency"/>
                    <field name="special_case" invisible="1"/>
                    <field name="partner_id" optional="show"/>
                    <field name="type_loan" optional="show"/>
                    <field name="with_guarantor" optional="hide"/>
                    <field name="partner_status_especific" optional="hide"/>
                    <field name="name" optional="show"/>
                    <field name="date"/>
                    <field name="date_payment"/>
                    <field name="period"/>
                    <field name="balance_capital" widget="monetary" options="{'currency_field': 'currency_id_dollar'}"
                           sum="Total"/>
                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id_dollar'}"
                           sum="Total"/>
                    <field name="amount_total_bs" widget="monetary" sum="Total"/>
                    <field name="amount_total_bolivianos" sum="Total" optional="hidden"/>
                    <field name="amount_payment" widget="monetary" sum="Total"/>
                    <field name="amount_returned_coa" optional="hidden" sum="Total"/>
                    <field name="state" decoration-info="state == 'init' or state == 'in_queue'"
                           decoration-success="state == 'progress' or state == 'done'" widget="badge"/>
                    <field name="state_account" widget="badge"/>
                    <button name="open_loan_payment" type="object" class="oe_highlight"
                            icon="fa-eye"/>
                </tree>
            </field>
        </record>

        <!-- Vista Formulario loan.application  -->

        <record model="ir.ui.view" id="loan_payment_form_id">
            <field name="name">loan.payment.form</field>
            <field name="model">loan.payment</field>
            <field name="arch" type="xml">
                <form string="Solicitud de presupuesto" class="oe_left oe_edit_only oe_form_required">
                    <header>
                        <button name="confirm_payment" string="Por transferencia bancaria" type="object"
                                class="oe_highlight"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('flag_state', '!=', 'progress')]}"
                                groups="rod_cooperativa.group_rod_cooperativa_administrator,rod_cooperativa.group_rod_cooperativa_operator"
                        />
                        <button name="confirm_ministry_defense" string="Por ministerio de defensa" type="object"
                                class="oe_highlight"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('flag_state', '!=', 'progress')]}"
                                groups="rod_cooperativa.group_rod_cooperativa_administrator,rod_cooperativa.group_rod_cooperativa_operator"
                        />
                        <button name="debt_settlement_min_def" string="Liquidacion de deuda por MINDEF" type="object"
                                class="oe_highlight"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('flag_state', '!=', 'liquidation_process')]}"
                                groups="rod_cooperativa.group_rod_cooperativa_administrator,rod_cooperativa.group_rod_cooperativa_operator"
                        />
                        <button name="debt_settlement_deposit" string="Liquidacion de deuda por deposito" type="object"
                                class="oe_highlight"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('flag_state', '!=', 'liquidation_process')]}"
                                groups="rod_cooperativa.group_rod_cooperativa_administrator,rod_cooperativa.group_rod_cooperativa_operator"
                        />
                        <button name="debt_settlement_contributions" string="Liquidacion de deuda con aportes"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('flag_state', '!=', 'liquidation_process')]}"
                                groups="rod_cooperativa.group_rod_cooperativa_administrator,rod_cooperativa.group_rod_cooperativa_operator"
                        />
                        <button name="confirm_ministry_defense_warrantor" string="Por ministerio de defensa garantes"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('flag_collect_guarantors', '!=', True)]}"
                                groups="rod_cooperativa.group_rod_cooperativa_administrator,rod_cooperativa.group_rod_cooperativa_operator"
                        />
                        <button name="not_discounted_loan" string="No descontado" type="object"
                                class="oe_highlight"
                                groups="base.group_no_one"
                        />
                        <button name="action_pay_mora" string="Descuento con mora" type="object"
                                class="oe_highlight"
                                groups="base.group_no_one"
                        />
                        <button name="scheduled_mora" string="Programado con mora" type="object"
                                class="oe_highlight"
                                groups="base.group_no_one"
                        />

                        <field name="state" widget="statusbar" statusbar_visible="draft,transfer,ministry_defense"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="loan_application_ids"/>
                                <field name="partner_id"/>
                                <field name="flag_state"/>
                                <field name="currency_id" invisible="1" groups="base.group_multi_currency"/>
                                <field name="currency_id_dollar" invisible="1" groups="base.group_multi_currency"/>
                                <field name="date"/>
                                <field name="date_payment"/>
                                <field name="period"/>
                                <field name="capital_index_initial"/>
                                <field name="capital_index_initial_bolivianos"/>
                                <field name="interest"/>
                                <field name="interest_base"/>
                                <field name="interest_base_bolivianos"/>
                                <field name="res_social"/>
                                <field name="res_social_bolivianos"/>
                                <field name="res_mortgage"/>
                                <field name="capital_initial" widget="monetary"
                                       options="{'currency_field': 'currency_id_dollar'}"/>
                                <field name="balance_capital" widget="monetary"
                                       options="{'currency_field': 'currency_id_dollar'}"/>
                                <field name="mount" widget="monetary"
                                       options="{'currency_field': 'currency_id_dollar'}"/>
                                <field name="interest_month_surpluy" sum="Total"/>
                                <field name="interest_month_surpluy_bolivianos"/>
                                <field name="percentage_amount_min_def"/>
                                <field name="percentage_amount_min_def_bolivianos"/>
                                <field name="commission_min_def"/>
                                <field name="loan_application_ids" invisible="1"/>
                                <!--                                <field name="type_payment" />-->
                                <field name="sancion"/>
                                <label for="date_initial_mora" string="Fecha inicial de mora" class="text-danger"/>
                                <field name="date_initial_mora" class="text-danger" nolabel="1"/>
                                <label for="date_end_mora" string="Fecha final de mora" class="text-danger"/>
                                <field name="date_end_mora" class="text-danger" nolabel="1"/>
                                <label for="days_mora" string="Dias de mora" class="text-danger"/>
                                <field name="days_mora" class="text-danger" nolabel="1"/>
                                <label for="amount_mora" string="Monto de mora" class="text-danger"/>
                                <field name="amount_mora" class="text-danger" nolabel="1"/>
                                <label for="amount_mora_bs" string="Monto de mora Bs." class="text-danger"/>
                                <field name="amount_mora_bs" class="text-danger" nolabel="1"/>
                                <!--                                <label for="amount_total_with_mora" string="Monto total con mora" class="text-danger"/>-->
                                <!--                                <field name="amount_total_with_mora" class="text-danger" nolabel="1"/>-->
                                <field name="amount_total_original" class="text-danger"/>
                                <field name="amount_total" widget="monetary"
                                       options="{'currency_field': 'currency_id_dollar'}"/>
                                <field name="amount_total_bs" widget="monetary"/>
                                <field name="amount_total_bolivianos"/>
                                <field name="amount_returned_coa"/>
                                <field name="amount_payment"/>

                            </group>
                            <group>
                                <field name="flag_collect_guarantors" widget="boolean_toggle"/>
                                <field name="guarantor_one"/>
                                <field name="code_garantor_one"/>
                                <field name="amount_desc_guarantor_one"/>
                                <field name="guarantor_two"/>
                                <field name="code_garantor_two"/>
                                <field name="amount_desc_guarantor_two"/>
                                <field name="special_case"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Contabilidad">
                                <label for="state_account" string="Estado de asiento contable"/>
                                <field name="state_account" decoration-danger="state_account == 'draft'"
                                       decoration-info="state_account == 'posted'"
                                       widget="badge"/>
                                <group>
                                    <field name="journal_id"/>
                                    <field name="account_move_id" readonly="1"/>
                                </group>
                                <group>
                                    <group string="Debe">
                                        <field name="account_income_id"/>
                                        <field name="amount_income"/>
                                    </group>
                                    <group string="Haber">
                                        <field name="account_capital_index_id"/>
                                        <field name="amount_capital_index"/>
                                        <field name="amount_capital_index_bs"/>
                                        <field name="account_interest_base"/>
                                        <field name="amount_interest"/>
                                        <field name="amount_interest_bs"/>
                                        <field name="account_res_social"/>
                                        <field name="amount_res_social"/>
                                        <field name="amount_res_social_bs"/>
                                        <field name="account_percentage_mindef"/>
                                        <field name="amount_percentage_mindef"/>
                                        <field name="amount_percentage_mindef_bs"/>
                                        <field name="account_overage_days"/>
                                        <field name="amount_overage_days"/>
                                        <field name="amount_overage_days_bs"/>
                                        <field name="account_overage_amount"/>
                                        <field name="amount_overage"/>
                                        <field name="amount_sum"/>
                                        <field name="amount_sum_bs"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="loan_payment_view_search_cooperativa" model="ir.ui.view">
            <field name="name">loan.payment.view.search.cooperativa</field>
            <field name="model">loan.payment</field>
            <field name="arch" type="xml">
                <search string="Buscar asociados">
                    <field name="code_contact" string="Código Socio"/>
                    <field name="ci_partner" string="C.I."/>
                    <field name="partner_id" string="Socio"/>
                    <field name="name" string="ID Pago"/>
                    <field name="account_move_id" string="Asiento Contable"/>
                    <field name="period" string="Periodo"/>
                    

                    <!--                    <field name="flag_state" string="Estado del préstamo (Flag)"/>-->

                    <separator/>
                    <filter string="Estado del prestamo " name="flag_state"/>
                    <filter string="Fecha Registro" name="filter_date" date="date"/>
                    <filter string="Fecha de Pago" name="filter_date_payment" date="date_payment"/>

                    <separator/>

                    <filter string="Borrador" name="state_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmado (Transferencia)" name="state_transfer"
                            domain="[('state', '=', 'transfer')]"/>
                    <filter string="Ministerio de Defensa" name="state_mindef"
                            domain="[('state', '=', 'ministry_defense')]"/>
                    <filter string="No Descontado" name="state_not_discounted"
                            domain="[('state', '=', 'not_discounted')]"/>

                    <separator/>

                    <group expand="0" string="Agrupar Por">
                        <!--                        <filter string="Periodo / Estado"-->
                        <!--                                name="group_period_state"-->
                        <!--                                context="{'group_by': ['period', 'state']}"/>-->
                        <filter string="Estado del Préstamo (Flag)"
                                name="group_flag_state"
                                context="{'group_by': 'flag_state'}"/>
                        <separator/>
                        <!--                        <filter string="Marcados (Flag)" name="flag_active" domain="[('flag_state', '=', True)]"/>-->
                        <filter string="Periodo" name="group_period" context="{'group_by': 'period'}"/>
                        <filter string="Fecha Registro" name="group_date" context="{'group_by': 'date'}"/>
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Asociado" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Tipo de Préstamo" name="group_type" context="{'group_by': 'type_loan'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_draft_massive_loan" model="ir.actions.server">
            <field name="name">Draft massive loan</field>
            <field name="model_id" ref="model_loan_payment"/>
            <field name="binding_model_id" ref="model_loan_payment"/>
            <field name="state">code</field>
            <field name="code">action = records.draft_massive()</field>
        </record>
        <record id="action_updated_amount_total" model="ir.actions.server">
            <field name="name">Actualizar monto original</field>
            <field name="model_id" ref="model_loan_payment"/>
            <field name="binding_model_id" ref="model_loan_payment"/>
            <field name="state">code</field>
            <field name="code">action = records.update_amount_total_original()</field>
        </record>
        <record id="action_publish_accounting_loan" model="ir.actions.server">
            <field name="name">Publicar asiento contable</field>
            <field name="model_id" ref="model_loan_payment"/>
            <field name="binding_model_id" ref="model_loan_payment"/>
            <field name="state">code</field>
            <field name="code">action = records.create_account_move()</field>
        </record>

        <!-- Accion para visualizar loan.application -->

        <record id="action_loan_payment" model="ir.actions.act_window">
            <field name="name">Pagos</field>
            <field name="res_model">loan.payment</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_loan_payments_not_discounted" model="ir.actions.act_window">
            <field name="name">Pagos no descontados por MINDEF</field>
            <field name="res_model">loan.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', 'in', ['not_discounted'])]</field>
            <field name="help">Este reporte muestra los pagos no descontados por MINDEF.</field>
            <field name="view_id" ref="loan_payment_report_tree_id"/>
        </record>

    </data>
</odoo>