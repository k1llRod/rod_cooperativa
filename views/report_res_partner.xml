<odoo>
    <data>
        <record id="view_res_partner_tree_custom" model="ir.ui.view">
            <field name="name">res.partner.tree.custom</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <tree string="Contactos Personalizados">
                    <field name="category_partner_id"/>
                    <field name="name"/>
                    <field name="partner_status_especific"/>
                </tree>
            </field>
        </record>
        <record id="action_res_partner_tree_custom" model="ir.actions.act_window">
            <field name="name">Relacion nominal de asociados sin prestamos (Activo y categoria "A")</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_res_partner_tree_custom"/>
            <field name="domain">[('loan_count', '=', 0)]</field>
        </record>
        <record id="view_res_partner_tree_custom_longevity" model="ir.ui.view">
            <field name="name">res.partner.tree.custom.longevity</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <tree string="Servicio pasivo por edad para el beneficio de longevidad">
                    <field name="category_partner_id"/>
                    <field name="name"/>
                    <field name="date_birthday"/>
                    <field name="years_completed"/>
                </tree>
            </field>
        </record>
        <record id="action_res_partner_tree_custom" model="ir.actions.act_window">
            <field name="name">Relacion nominal de asociados sin prestamos (Activo y categoria "A")</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_res_partner_tree_custom"/>
            <field name="domain">[('loan_count', '=', 0)]</field>
        </record>
        <record id="action_res_partner_tree_custom_longevity" model="ir.actions.act_window">
            <field name="name">Relacion nominal de asociados del servicio pasivo por edad para el beneficio de longevidad</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_res_partner_tree_custom_longevity"/>
            <field name="domain">[('partner_status_especific', '=', 'passive_reserve_b'),('state','=','activate')]</field>
            <field name="context">{'group_by': 'years_completed'}</field>
        </record>
        <record id="view_loan_application_up_tree_custom" model="ir.ui.view">
            <field name="name">loan.application.tree.custom</field>
            <field name="model">loan.application</field>
            <field name="arch" type="xml">
                <tree string="Prestamos altas">
                    <field name="category_partner"/>
                    <field name="partner_id"/>
                    <field name="date_approval"/>
                    <field name="months_quantity"/>
                    <field name="accounting_entry_id"/>
                    <field name="nro_cheque"/>
                    <field name="amount_loan_dollars"/>
                    <field name="amount_loan"/>
<!--                    <field name="last_payment_id"/>-->
<!--                    <field name="state_last_payment"/>-->
                </tree>
            </field>
        </record>
        <record id="view_loan_application_down_tree_custom" model="ir.ui.view">
            <field name="name">loan.application.tree.custom</field>
            <field name="model">loan.application</field>
            <field name="arch" type="xml">
                <tree string="Prestamos bajas">
                    <field name="category_partner"/>
                    <field name="partner_id"/>
                    <field name="date_approval"/>
                    <field name="months_quantity"/>
                    <field name="accounting_entry_id"/>
                    <field name="nro_cheque"/>
                    <field name="amount_loan_dollars"/>
                    <field name="amount_loan"/>
                    <field name="last_payment_id"/>
<!--                    <field name="state_last_payment"/>-->
                </tree>
            </field>
        </record>
        <record id="action_loan_application_up_custom" model="ir.actions.act_window">
            <field name="name">Reporte de Prestamos Altas</field>
            <field name="res_model">loan.application</field>
            <field name="view_mode">tree,form</field>
<!--            <field name="domain">[('state', '=', 'approved')]</field>-->
<!--            <field name="context">{'search_default_state': 1}</field>-->
            <field name="help">Este reporte muestra los prestamos aprobados.</field>
            <field name="view_id" ref="view_loan_application_up_tree_custom"/>
        </record>
        <record id="action_loan_application_down_custom" model="ir.actions.act_window">
            <field name="name">Reporte de Prestamos Bajas</field>
            <field name="res_model">loan.application</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', 'in', ['liquidation_process', 'done'])]</field>
            <field name="help">Este reporte muestra los prestamos concluidos.</field>
            <field name="view_id" ref="view_loan_application_down_tree_custom"/>
        </record>
        <record id="action_loan_application_hipotecary_custom" model="ir.actions.act_window">
            <field name="name">Prestamos hipotecarios realizados</field>
            <field name="res_model">loan.application</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', 'in', ['progress']),('with_guarantor','=','mortgage')]</field>
            <field name="help">Este reporte muestra los prestamos concluidos.</field>
            <field name="view_id" ref="view_loan_application_down_tree_custom"/>
        </record>

