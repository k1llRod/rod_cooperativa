<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_cooperativa" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cooperativa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block"
                     data-string="Cooperativa"
                     string="Cooperativa de Ahorro y Crédito"
                     data-key="rod_cooperativa_aportes">

                    <h2>Valores para Tabla de Préstamos</h2>
                    <div class="row mt16 o_settings_container" name="cooperativa_setting_container">

                        <div class="col-12 col-lg-6 o_setting_box" id="cooperativa_rates_setting">
                            <div class="o_setting_right_pane">
                                <div class="content-group mt16">

                                    <label string="Interés mensual %" for="monthly_interest"/>
                                    <div class="text-muted">Establecer el porcentaje de interés mensual.</div>
                                    <div class="mb16">
                                        <field name="monthly_interest" class="oe_inline"/> %%
                                    </div>

                                    <label string="Fondo de contingencia %" for="contingency_fund"/>
                                    <div class="mb16">
                                        <field name="contingency_fund" class="oe_inline"/> %%
                                    </div>

                                    <label string="Préstamo hipotecario %" for="mortgage_loan"/>
                                    <div class="mb16">
                                        <field name="mortgage_loan" class="oe_inline"/> %%
                                    </div>
                                    <label string="Interés mensual hipotecario %" for="monthly_interest_mortgage"/>
                                    <div class="mb16">
                                        <field name="monthly_interest_mortgage" class="oe_inline"/> %%
                                    </div>

                                    <label string="Préstamo hipotecario especial %" for="mortgage_especial_loan"/>
                                    <div class="text-muted">Establecer el recargo/fondo para préstamo hipotecario especial.</div>
                                    <div class="mb16">
                                        <field name="mortgage_especial_loan" class="oe_inline"/> %%
                                    </div>

                                    <label string="Interés mensual hipotecario especial %" for="monthly_interest_mortgage_especial"/>
                                    <div class="text-muted">Establecer la tasa de interés mensual para préstamo hipotecario especial.</div>
                                    <div class="mb16">
                                        <field name="monthly_interest_mortgage_especial" class="oe_inline"/> %%
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="cooperativa_accounts_setting">
                            <div class="o_setting_right_pane">
                                <div class="content-group mt16">
                                    <div class="row mt8">
                                        <label for="account_loan_id" class="col-lg-9 o_light_label" string="Cuenta contable de préstamos (Debe)"/>
                                        <field name="account_loan_id" class="col-lg-12" options="{'no_create': True}"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="account_egreso_id" class="col-lg-9 o_light_label" string="Cuenta contable de egreso de intereses (Haber)"/>
                                        <field name="account_egreso_id" class="col-lg-12" options="{'no_create': True}"/>
                                    </div>
                                    </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="rod_cooperativa.action_cooperativa_configuration" model="ir.actions.act_window">
        <field name="name">Ajustes de la cooperativa</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>
</odoo>