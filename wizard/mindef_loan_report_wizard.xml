<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mindef_loan_report_wizard_form" model="ir.ui.view">
        <field name="name">mindef.loan.report.wizard.form</field>
        <field name="model">mindef.loan.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte Mensual de Préstamos">
                <group>
                    <group string="Periodo de Consulta">
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                    <group string="Resumen del Periodo">
                        <field name="draft_quantity"/>
                        <field name="reconciled_quantity"/>
                        <field name="no_reconciled_quantity"/>
                        <field name="observed_quantity"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Generar Reporte" type="object" class="oe_highlight"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mindef_loan_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Mensual Mindef</field>
        <field name="res_model">mindef.loan.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_mindef_reports_category"
              name="Ministerio de Defensa"
              parent="rod_cooperativa.rod_cooperativa_loan_report"
              sequence="10"/>

    <menuitem id="menu_mindef_loan_report"
              name="Reporte Mensual Préstamos"
              parent="menu_mindef_reports_category"
              action="action_mindef_loan_report_wizard"
              sequence="1"/>
</odoo>