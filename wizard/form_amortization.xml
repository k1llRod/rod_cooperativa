<odoo>
    <data>
        <record model="ir.ui.view" id="form_amortization_id">
            <field name="name">form.amortization.form</field>
            <field name="model">form.amortization</field>
            <field name="arch" type="xml">
                <form string="Amortizacion de prestamos">
                    <group>
                        <group string="Datos del prestamo">
                            <field name="data_loan_id" readonly="1"/>
                            <field name="scheduled" invisible="1"/>
                            <field name="with_guarantor"/>
                            <field name="capital_initial" readonly="1"/>
                            <field name="quantity_month_initial" readonly="1"/>
                            <field name="quantity_month_payment" readonly="1"/>
                            <field name="capital_rest" readonly="1"
                                   class="oe_inline"
                                   decoration-danger="scheduled == True"/>
                            <field name="capital_rest" readonly="1"
                                   decoration-danger="scheduled"/>
                            <field name="interest_days_rest" readonly="1"/>
                            <field name="interest_days_rest_bs" readonly="1"/>
                            <field name="total_fixed_fee" readonly="1"/>
                        </group>
                        <group string="Datos para amortizar">
                            <field name="amount_amortization"/>
                            <field name="month_amortization"/>
                            <field name="date_amortization"/>
                            <field name="recalculate_capital_rest"/>
                            <field name="month_rest"/>
                            <field name="new_fixed_fee"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

<!--        <record model="ir.actions.act_window" id="alert_message_action">-->
<!--            <field name="name">Alert message</field>-->
<!--            <field name="type">ir.actions.act_window</field>-->
<!--            <field name="res_model">alert.message</field>-->
<!--            <field name="view_mode">form</field>-->
<!--            <field name="view_id" ref="alert_message_form_view" />-->
<!--            <field name="target">new</field>-->
<!--        </record>-->
    </data>
</odoo>
